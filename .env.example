# ==== SAQI-MD Configuration ====
BOT_NAME=SAQI-MD
PREFIX=.
OWNER_NAME=Attitude King
OWNER_NUMBERS=923106762478        # comma-separated, e.g. 923106762478,923134182952

# ==== MongoDB (REQUIRED for production) ====
# MongoDB Atlas -> free M0 cluster -> connect -> drivers -> Node.js connection string
MONGODB_URI=
SESSION_ID=saqi-md-session

# ==== Behaviour ====
MODE=public                       # public | private
TIMEZONE=Asia/Karachi
AUTO_READ=true
WELCOME=true
GOODBYE=true
PORT=3000

# ==== Speed ====
# Link preview off = URL wale replies 3s tak nahi rukte (default fast). 1 = preview on.
SAQI_LINK_PREVIEW=0
# Quoted reply off = har jawab bina original message quote ke (default fast). 0 = purana quoted behaviour.
SAQI_FAST_REPLY=1

# ==== Optional: AI commands ====
GEMINI_API_KEY=
